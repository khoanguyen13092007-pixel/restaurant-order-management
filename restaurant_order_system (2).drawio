    <mxCell id="nt455" value="Ghi chú: Waiter, Chef, Cashier, Manager kế thừa User (mũi tên rỗng; ánh xạ bảng ACCOUNT, phân biệt bằng roleId). Quan hệ dùng ký hiệu chân chim như ERD; nét đứt = phụ thuộc. Giá trị trạng thái đề xuất: Order = DRAFT/CONFIRMED/PAID/CANCELLED; OrderItem = PENDING/RECEIVED/COOKING/DONE/CANCELLED; RestaurantTable = AVAILABLE/OCCUPIED/RESERVED; Payment.method = CASH/CARD/TRANSFER." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
     <mxGeometry x="40" y="1268" width="1400" height="60" as="geometry" />
    </mxCell>
